# Leave these blank in local development so REST and Socket.IO use Vite's
# /api and /socket.io proxies. In production set each to the backend origin.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_MAX_CHAT_ATTACHMENT_MB=1000
VITE_MAX_CHAT_IMAGE_MB=1000
VITE_MAX_CHAT_AUDIO_MB=1000
VITE_MAX_CHAT_VIDEO_MB=1000
VITE_MAX_CHAT_FILE_MB=1000
VITE_MAX_STATUS_IMAGE_MB=25
VITE_MAX_STATUS_VIDEO_MB=150
VITE_MAX_REEL_IMAGE_MB=1000
VITE_MAX_REEL_VIDEO_MB=1000
VITE_STATUS_CAPTION_MAX_LENGTH=300
VITE_MAX_FILES_PER_MESSAGE=5
VITE_MAX_TEXT_MESSAGE_LENGTH=5000
VITE_GOOGLE_CLIENT_ID=383136924253-t7ulp2q7fk76dqhbp8r9glpg9bs16bjm.apps.googleusercontent.com
VITE_STRIPE_PUBLIC_KEY=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Public site key for the same Cloudflare Turnstile widget configured by the API.
VITE_TURNSTILE_SITE_KEY=
VITE_MAX_PROFILE_IMAGE_MB=25
