CHAT_MESSAGE_EDIT_MINUTES=150
CHAT_MESSAGE_DELETE_MINUTES=600
CHAT_CONNECTION_RATE_LIMIT=200
CHAT_MESSAGE_RATE_LIMIT=300
CHAT_ROOM_MESSAGE_RATE_LIMIT=1200
CHAT_TYPING_RATE_LIMIT=600
CHAT_ROOM_TYPING_RATE_LIMIT=2400
CHAT_RATE_LIMIT_WINDOW_SECONDS=600
VIEW_ONCE_TOKEN_EXPIRE_SECONDS=1200
MAX_PROFILE_IMAGE_MB=25
MAX_CHAT_ATTACHMENT_MB=1000
MAX_CHAT_IMAGE_MB=1000
MAX_CHAT_AUDIO_MB=1000
MAX_CHAT_VIDEO_MB=1000
MAX_CHAT_FILE_MB=1000
MAX_PROJECT_MEDIA_MB=1000
FINAL_DELIVERY_MAX_BYTES=1000000000
MAX_VOICE_MESSAGE_MB=1000
MAX_AUDIO_MB=1000
MAX_DOCUMENT_MB=1000
MAX_ZIP_MB=1000
MAX_VIDEO_MB=1000
MAX_VIEW_ONCE_VIDEO_MB=1000
MAX_STATUS_IMAGE_MB=25
MAX_STATUS_VIDEO_MB=150
PROFILE_IMAGE_MAX_DIMENSION=2048
STATUS_IMAGE_MAX_DIMENSION=4096
IMAGE_MAX_PIXELS=80000000
MAX_REEL_IMAGE_MB=1000
MAX_REEL_VIDEO_MB=1000
STATUS_LIFETIME_HOURS=24
STATUS_VIDEO_MAX_SECONDS=90
MAX_STATUS_VIDEO_DURATION_SECONDS=90
MAX_REEL_VIDEO_DURATION_SECONDS=90
FFPROBE_PATH=ffprobe
STATUS_CAPTION_MAX_LENGTH=300
MAX_FILES_PER_MESSAGE=5
MAX_TEXT_MESSAGE_LENGTH=5000

# JWT and session policy
JWT_ALGORITHM=HS256
JWT_ISSUER=editzone-api
JWT_AUDIENCE=editzone-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=10

# Uploads, scanning and private S3 storage
MAX_UPLOAD_MB=1000
DIRECT_UPLOAD_MIN_MB=25
MALWARE_SCAN_MAX_MB=1000
MALWARE_SCAN_TIMEOUT_SECONDS=120
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MEDIA_SCANNER_ENABLED=false
MEDIA_SCAN_MAX_ATTEMPTS=3
# Prefer this when clamd exposes a local Unix socket; leave blank for TCP.
MEDIA_SCANNER_SOCKET=
CLAMAV_CONNECT_TIMEOUT_SECONDS=5
MEDIA_LINK_EXPIRE_MINUTES=5
MEDIA_RETENTION_DAYS=30
# Private identity-verification bucket. Legacy alias: AWS_S3_BUCKET.
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_TEXTRACT_REGION=ap-south-1
NIC_OCR_PROVIDER=aws_textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_PREFIX=editzone/project-media
S3_MULTIPART_EXPIRE_HOURS=24
S3_PRESIGNED_URL_EXPIRE_SECONDS=900
NIC_IMAGE_MAX_MB=100
NIC_OCR_MIN_CONFIDENCE=80
AWS_TEXTRACT_MIN_CONFIDENCE=70
AWS_REKOGNITION_SIMILARITY_THRESHOLD=85
SELFIE_MAX_UPLOAD_MB=5
SELFIE_VERIFICATION_MAX_ATTEMPTS=3
SELFIE_LIVENESS_TIMEOUT_SECONDS=20
IDENTITY_RATE_LIMIT_ATTEMPTS=5
IDENTITY_RATE_LIMIT_MINUTES=15
IDENTITY_DOCUMENT_RETENTION_DAYS=7

# Email and abuse protection
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@editzone.com
TURNSTILE_SECRET_KEY=



PAYHERE_SANDBOX=true
PAYHERE_MODE=sandbox
PAYHERE_SANDBOX_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_NOTIFY_URL=https://YOUR-PUBLIC-BACKEND.example/api/v1/payments/payhere/notify
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=
# Generate this key pair once and keep it stable across deployments.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
PROJECT_MIN_AMOUNT=50.00
PROJECT_MAX_AMOUNT=10000000.00
CLIENT_SERVICE_FEE_PERCENT=10
EDITOR_COMMISSION_PERCENT=10
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
