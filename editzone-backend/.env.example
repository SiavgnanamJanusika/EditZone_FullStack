MONGO_DB_NAME=editzone
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_SOCKET_TIMEOUT_MS=120000
MONGO_MAX_POOL_SIZE=500
MONGO_MIN_POOL_SIZE=0
MONGO_WAIT_QUEUE_TIMEOUT_MS=15000
MONGO_STARTUP_RETRIES=3
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=383136924253-t7ulp2q7fk76dqhbp8r9glpg9bs16bjm.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
SOCKET_CORS_ORIGINS=["http://localhost:5173"]
CHAT_RETENTION_DAYS_AFTER_COMPLETION=300
MEDIA_RETENTION_DAYS_AFTER_COMPLETION=300
